{
  "name": "meoxp-bot",
  "version": "2.0.0",
  "description": "Discord Music Bot with TypeScript and Moodenglink",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src tests",
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "node scripts/install-git-hooks.mjs",
    "setup:hooks": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@seald-io/nedb": "4.1.2",
    "cors": "2.8.6",
    "discord.js": "14.27.0",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "moodenglink": "github:Moodeng-LAB/moodenglink",
    "socket.io": "4.8.3",
    "systeminformation": "5.33.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0"
  }
}
